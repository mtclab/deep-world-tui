// Data-driven production for registry trade goods (#678 slice 3).
//
// Vec<ProductionRule>: which trades make which good, in what measure. The
// living economy reads this each day; adding a good's producers is pure data.
//   good:         registry slug (must exist in data/goods.ron)
//   by:           [(profession, weight)] — head-count × weight contributions
//   coastal_base: flat amount added only in coastal settlements (default 0)
//   coastal_only: rule yields nothing inland (default false)
//   richness:     yield scales with the region's wildness (default false)
//
// Professions are the `profession` roster (charts.ron), e.g. fisher, miner,
// baker, weaver, dyer, herbalist, forager, herder, farmer, butcher, chandler,
// scribe, perfumer, mason, rope-maker, brewer, beast-handler.
[
    // ── Salt & sea ────────────────────────────────────────────────────────
    (good: "salt",        by: [("miner", 0.4)], coastal_base: 0.4),
    (good: "salt-fish",   by: [("fisher", 0.5)]),
    (good: "fish-sauce",  by: [("fisher", 0.2)], coastal_only: true),
    (good: "canvas",      by: [("rope-maker", 0.2), ("weaver", 0.2)], coastal_only: true),

    // ── Mine & quarry ───────────────────────────────────────────────────────
    (good: "copper",      by: [("miner", 0.3)]),
    (good: "tin",         by: [("miner", 0.15)]),
    (good: "lead",        by: [("miner", 0.12)]),
    (good: "marble",      by: [("mason", 0.3)]),
    (good: "lime",        by: [("mason", 0.2)]),

    // ── Field, mill & oven ──────────────────────────────────────────────────
    (good: "grain",       by: [("farmer", 0.2)]),
    (good: "flour",       by: [("baker", 0.3), ("miller", 0.5)]),
    (good: "bread",       by: [("baker", 0.6)]),
    (good: "honey",       by: [("farmer", 0.05), ("beekeeper", 0.6)]),
    (good: "egg",         by: [("farmer", 0.15)]),

    // ── Herd & dairy ────────────────────────────────────────────────────────
    (good: "wool",        by: [("herder", 0.3)]),
    (good: "cheese",      by: [("herder", 0.15)]),
    (good: "butter",      by: [("herder", 0.1), ("farmer", 0.05)]),
    (good: "tallow",      by: [("butcher", 0.3)]),
    (good: "smoked-meat", by: [("butcher", 0.3)]),
    (good: "sinew",       by: [("butcher", 0.1)], richness: true),

    // ── Loom & vat ──────────────────────────────────────────────────────────
    (good: "linen",       by: [("weaver", 0.3), ("dyer", 0.2)]),
    (good: "felt",        by: [("weaver", 0.2)]),
    (good: "rope",        by: [("rope-maker", 0.5)]),
    (good: "dye-woad",    by: [("dyer", 0.4)]),
    (good: "dye-madder",  by: [("dyer", 0.3)]),

    // ── Drink ───────────────────────────────────────────────────────────────
    (good: "wine",        by: [("brewer", 0.3), ("vintner", 0.6)]),
    (good: "mead",        by: [("brewer", 0.2), ("beekeeper", 0.3)]),

    // ── Light, fat & sundries (the chandler's bench) ──────────────────────────
    (good: "candle",      by: [("chandler", 0.5)]),
    (good: "soap",        by: [("chandler", 0.3)]),
    (good: "lamp-oil",    by: [("chandler", 0.3)]),
    (good: "beeswax",     by: [("beekeeper", 0.3), ("chandler", 0.1)]),

    // ── Letters & temple ──────────────────────────────────────────────────────
    (good: "parchment",   by: [("scribe", 0.3), ("archivist", 0.3)]),
    (good: "ink",         by: [("scribe", 0.2)]),
    (good: "incense",     by: [("perfumer", 0.5), ("priest", 0.1)]),

    // ── Forage & physic ───────────────────────────────────────────────────────
    (good: "willow-bark", by: [("herbalist", 0.3), ("forager", 0.3)]),
    (good: "dried-fruit", by: [("forager", 0.2)]),
    (good: "dried-thyme", by: [("forager", 0.15), ("herbalist", 0.1)]),

    // ── Wood & wild ───────────────────────────────────────────────────────────
    (good: "antler",      by: [("forager", 0.1), ("beast-handler", 0.1)], richness: true),
    (good: "fur",         by: [("beast-handler", 0.2)], richness: true),
    (good: "feather",     by: [("fisher", 0.05), ("forager", 0.05)]),

    // ── Expansion producers (#678 s3b) ───────────────────────────────────
    (good: "thread",      by: [("weaver", 0.2)]),
    (good: "hemp",        by: [("farmer", 0.1)]),
    (good: "fishing-net", by: [("rope-maker", 0.3)], coastal_only: true),
    (good: "sailcloth",   by: [("weaver", 0.2)], coastal_only: true),
    (good: "pearl",       by: [("fisher", 0.05)], coastal_only: true),
    (good: "whetstone",   by: [("mason", 0.2)]),
    (good: "hinge",       by: [("smith", 0.2)]),
    (good: "lock",        by: [("smith", 0.15)]),
    (good: "plough",      by: [("smith", 0.1)]),
    (good: "bell",        by: [("smith", 0.05)]),
    (good: "cartwheel",   by: [("carpenter", 0.2)]),
    (good: "comb",        by: [("engraver", 0.3)]),
    (good: "horn",        by: [("butcher", 0.15)]),
    (good: "glass-bead",  by: [("glass-worker", 0.2)]),
    (good: "vinegar",     by: [("brewer", 0.15)]),
    (good: "apple",       by: [("farmer", 0.1)]),
    (good: "onion",       by: [("farmer", 0.1)]),
    (good: "turnip",      by: [("farmer", 0.1)]),
    (good: "oats",        by: [("farmer", 0.12)]),
    (good: "nuts",        by: [("forager", 0.2)]),
    (good: "dried-mushroom", by: [("forager", 0.15)]),
    (good: "yarrow",      by: [("herbalist", 0.2), ("forager", 0.2)]),
    (good: "comfrey",     by: [("herbalist", 0.2)]),
    (good: "mint",        by: [("herbalist", 0.15), ("forager", 0.1)]),
    (good: "chamomile",   by: [("herbalist", 0.15)]),

    // ── Variety pass (goods phase-2): biome-gated production ──────────────
    // Different grains by band: rye north, wheat/emmer warm-south, millet
    // steppe; barley/buckwheat anywhere. Other bands' grain reaches a town as
    // an import, not a local field.
    (good: "rye",         by: [("farmer", 0.18)], regions: ["forest", "tundra", "upland"]),
    (good: "barley",      by: [("farmer", 0.16)]),
    (good: "wheat",       by: [("farmer", 0.2)],  regions: ["delta", "river_valley"]),
    (good: "emmer",       by: [("farmer", 0.12)], regions: ["delta", "river_valley"]),
    (good: "millet",      by: [("farmer", 0.15)], regions: ["steppe"]),
    (good: "buckwheat",   by: [("farmer", 0.1)]),
    (good: "malt",        by: [("brewer", 0.3)]),
    (good: "sahti",       by: [("brewer", 0.3)], regions: ["forest", "tundra", "upland"]),
    (good: "rye-bread",   by: [("baker", 0.4)], regions: ["forest", "tundra", "upland"]),
    (good: "wheat-bread", by: [("baker", 0.4)], regions: ["delta", "river_valley"]),
    (good: "flatbread",   by: [("baker", 0.4)], regions: ["steppe"]),
    (good: "crispbread",  by: [("baker", 0.3)], regions: ["forest", "tundra", "upland"]),

    // Dairy & the steppe larder (goat-milk cheese, fermented milk, dried curd).
    (good: "milk",        by: [("herder", 0.2), ("farmer", 0.05)]),
    (good: "goat-milk",   by: [("herder", 0.2)], regions: ["steppe", "upland"]),
    (good: "curd",        by: [("herder", 0.12)]),
    (good: "goat-cheese", by: [("herder", 0.15)], regions: ["steppe", "upland"]),
    (good: "ewe-cheese",  by: [("herder", 0.12)], regions: ["delta", "river_valley", "upland"]),
    (good: "dried-curd",  by: [("herder", 0.12)], regions: ["steppe"]),
    (good: "kumis",       by: [("herder", 0.15)], regions: ["steppe"]),
    (good: "cured-meat",  by: [("butcher", 0.25)], regions: ["steppe"]),
    (good: "dung-cake",   by: [("herder", 0.1)], regions: ["steppe"]),

    // Warm-south / Mediterranean-like — the wine, oil & orchard band.
    (good: "grape",       by: [("farmer", 0.18)], regions: ["delta", "river_valley"]),
    (good: "must",        by: [("vintner", 0.4), ("farmer", 0.1)], regions: ["delta", "river_valley"]),
    (good: "fig",         by: [("farmer", 0.12)], regions: ["delta", "river_valley"]),
    (good: "almond",      by: [("forager", 0.12)], regions: ["delta", "river_valley"]),
    (good: "olive",       by: [("farmer", 0.15)], regions: ["delta", "river_valley"]),
    (good: "terracotta",  by: [("potter", 0.3), ("mason", 0.1)], regions: ["delta", "river_valley"]),
    (good: "oak-plank",   by: [("carpenter", 0.2)], regions: ["delta", "river_valley", "forest"]),

    // Fish by kind (coast & river).
    (good: "fish",        by: [("fisher", 0.4)], coastal_only: true),
    (good: "herring",     by: [("fisher", 0.3)], coastal_only: true),
    (good: "whitefish",   by: [("fisher", 0.25)], coastal_only: true),
    (good: "roe",         by: [("fisher", 0.1)], coastal_only: true),
    (good: "fish-oil",    by: [("fisher", 0.15)], coastal_only: true),
    (good: "pike",        by: [("fisher", 0.2)], regions: ["river_valley", "delta", "swamp"]),
    (good: "eel",         by: [("fisher", 0.15)], regions: ["river_valley", "delta", "swamp"]),

    // Furs by beast — the cold north's wild take (scales with wildness).
    (good: "fox-pelt",    by: [("hunter", 0.2), ("beast-handler", 0.1)], richness: true, regions: ["forest", "tundra", "upland"]),
    (good: "marten-pelt", by: [("hunter", 0.15)], richness: true, regions: ["forest", "tundra"]),
    (good: "ermine-pelt", by: [("hunter", 0.1)], richness: true, regions: ["tundra", "upland"]),
    (good: "bear-pelt",   by: [("hunter", 0.08)], richness: true, regions: ["forest", "upland"]),

    // Woods, fuels & the north's tar.
    (good: "pine-plank",  by: [("carpenter", 0.3), ("forester", 0.2)], regions: ["forest", "upland"]),
    (good: "birch-bark",  by: [("forester", 0.3), ("forager", 0.2)], regions: ["forest", "tundra"]),
    (good: "firewood",    by: [("forester", 0.4)]),
    (good: "shingle",     by: [("carpenter", 0.2)]),
    (good: "tar",         by: [("forester", 0.3)], regions: ["forest", "tundra", "upland"]),
    (good: "mahla",       by: [("forager", 0.2)], regions: ["forest", "tundra"]),
]
