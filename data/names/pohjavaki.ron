// Pohjaväki — Kukresh deep-bottom folk (Mari-calibrated register).
// Darkest vowels (o, u) in the family's š/ñ frame; heavy -om/-um/-am finals.
NameGrammar(
    prefixes: ["ñur", "šomu", "huk", "molš", "ñok", "umš", "šur", "hoñ"],
    roots: [
        "ñolum", "šukram", "hovum", "muršam", "oñkum", "šulmo", "ñukšam",
        "homšur", "ulñam", "šorkum", "ñumol", "kušmam", "ohšum", "ñurmo",
        "šombul", "hukšam", "molñum", "uškom",
    ],
    suffixes: ["om", "um", "ñum", "šum", "mo", "uk", "am"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
