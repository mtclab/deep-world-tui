// Khör — endothermic steppe people (isolate, wind register)
// Breathy h/kh onsets, front-rounded ö and y, short wind-flat roots, ž fricative.
// Opaque coinages only — no dictionary words, no god-name substrings.
NameGrammar(
    prefixes: ["khö", "hyr", "övk", "höm", "khy", "ölk", "hyž", "ymö"],
    roots: [
        "khöt", "hyrm", "khöž", "hyrt", "övkh", "khys",
        "hövt", "khyz", "ölkh", "hömyr", "khövr", "öht",
        "khylt", "höžyr", "ymkh", "ymhör", "khövy", "hyžöt",
    ],
    suffixes: ["öt", "yr", "ökh", "ym", "öž", "yt", "ör"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
