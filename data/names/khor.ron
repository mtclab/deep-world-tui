// Khör name grammar — tundra/steppe-people naming tradition
// Roots: cold, wind, endurance, oral tradition
NameGrammar(
    prefixes: ["Khor", "Vat", "Sty", "Rök", "Tun", "Fäl", "Gor", "Nar"],
    roots: [
        "Khor", "Vat", "Sty", "Rök", "Tun", "Fäl", "Gor", "Nar",
        "Fro", "Sten", "Is", "Snö", "Vind", "Kall", "Nor",
        "Mör", "Bär", "Ulv", "Val", "Hed", "Mol",
    ],
    suffixes: ["ör", "en", "ar", "ul", "ek", "ir"],
    patterns: [Root, RootSuffix, PrefixRoot],
)