// Koskimetsä name grammar — river-rapids forest folk, Keurish naming tradition
// Sámic-calibrated invented roots: liquid-heavy (l, r), names that run and eddy
// like white water under the trees
NameGrammar(
    prefixes: ["lirva", "vuoll", "rielo", "lyrva", "šolle", "virla", "luorv", "relvy"],
    roots: [
        "lourva", "lyrvve", "rielva", "vuorla", "šurle", "larvvo",
        "lielly", "norrla", "čirla", "myrla", "luolva", "rievvo",
        "lalvve", "rilvo", "rouli", "lervä", "vuolri", "rälvvo",
    ],
    suffixes: ["lvä", "rro", "llo", "rva", "lu", "rri", "ly"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
