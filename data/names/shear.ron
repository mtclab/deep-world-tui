// She'ar — steppe people who reject writing (non-human isolate).
// Sparse and short: sh-/sh’- initials, glottal stops, names spoken once and kept.
NameGrammar(
    prefixes: ["sha", "sh’u", "sho", "za’i", "ash", "s’ai", "shi", "ha’"],
    roots: [
        "shek", "s’ul", "sho’l", "ashk", "shid", "sh’ek", "zash",
        "shul", "ish’a", "shok", "s’ar", "shazu", "ash’u", "shi’l",
        "zhul", "shau", "s’ek", "shoz",
    ],
    suffixes: ["’a", "ak", "’ul", "ish", "za", "’ek", "ho"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
