// Metsäreunat name grammar — forest-edge Keurish naming tradition
// Sámic-calibrated invented roots: liminal register, harder stops (k, t, p) mixed
// into the soft forest base — border-folk who trade with the open country
NameGrammar(
    prefixes: ["kärvi", "tualv", "pyške", "čolta", "virče", "telvy", "narku", "šolku"],
    roots: [
        "koltva", "tyrkve", "palčče", "vätko", "čalpe", "nurtti",
        "kävlo", "torkva", "pelvä", "tačča", "kortve", "viltka",
        "huotka", "čirpe", "kaltvo", "myrtkä", "solpe", "ärtko",
    ],
    suffixes: ["ttä", "lke", "rto", "čä", "pe", "tvä", "ko"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
