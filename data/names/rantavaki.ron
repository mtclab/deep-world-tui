// Rantaväki — Masaran shore-folk (Permic-calibrated register).
// Broader open vowels (a, o, e) over the family's voiced v/z/d core; -i and -a finals.
NameGrammar(
    prefixes: ["ravo", "odza", "zalvo", "davre", "olva", "vazo", "redol", "azva"],
    roots: [
        "ravdi", "olza", "vando", "zarvi", "lavo", "odvi", "razva",
        "volda", "avzi", "darvo", "lozai", "vodla", "arzvi", "davlo",
        "ozari", "vazdo", "redva", "alvoi",
    ],
    suffixes: ["va", "da", "oi", "ai", "zo", "la", "vi"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
