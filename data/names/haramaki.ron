// Härämäki — Kukresh steep-valley folk (Mari-calibrated register).
// Harder k clusters (šk, kt, rk) against the family's š/ñ frame; -am/-em finals.
NameGrammar(
    prefixes: ["kaš", "ñerk", "hošk", "mukt", "škar", "keñ", "ašk", "korš"],
    roots: [
        "karšem", "ñoktam", "škovem", "keršam", "muktam", "oškñem", "ñakrem",
        "tyškam", "korñem", "ekšam", "ñurkam", "šaktem", "hörkam", "äkšem",
        "miktaš", "ñoršem", "kuštam", "arkñem",
    ],
    suffixes: ["kam", "kem", "ak", "ška", "ñek", "am", "ko"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
