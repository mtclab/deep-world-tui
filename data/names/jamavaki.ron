// Jämäväki — Kukresh hidden-valley folk (Mari-calibrated register).
// Very short roots (3-4): clipped, quiet, š/ñ-heavy; whispers more than names.
NameGrammar(
    prefixes: ["ñim", "šov", "häm", "ulš", "mik", "ñaš", "hep", "šum"],
    roots: [
        "ñam", "šim", "hov", "myš", "ñel", "šak", "hemš",
        "ñur", "ošm", "šäm", "ñov", "šul", "mäkš", "ñiš",
        "šom", "hul", "ñakt", "šev",
    ],
    suffixes: ["am", "em", "ñi", "ša", "oš", "mä", "ak"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
