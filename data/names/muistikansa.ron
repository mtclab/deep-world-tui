// Muistikansa — memory-keepers (Sampsaran family, Mordvinic-calibrated)
// Softer register than arkit: long vowels (ee, ää, ii), nasal/liquid consonants.
// Opaque coinages only — no dictionary words, no god-name substrings.
NameGrammar(
    prefixes: ["vee", "sää", "mii", "nää", "lee", "äle", "vei", "sii"],
    roots: [
        "veeläs", "säänet", "leevän", "miinet", "ääles", "neevät",
        "seelmä", "elnäs", "määnit", "veemät", "näälev", "miemäs",
        "lääven", "sevään", "veimäs", "älvee", "miernä", "sälvii",
    ],
    suffixes: ["en", "äs", "ne", "vä", "il", "mä", "et"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
