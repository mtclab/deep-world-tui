// Muistikansa name grammar — memory-keeper naming tradition
// Sampsaran family: Mordvinic profile with front æ and final t
// Roots: memory, oral tradition, song, ancient stories, elders
NameGrammar(
    prefixes: ["Vanha", "Muis", "Iksi", "Esi", "Eno", "Sana", "Laulu", "Säke"],
    roots: [
        "Sär", "Vel", "Tär", "Muis", "Laul", "Säke", "Iks",
        "Vano", "Perä", "Laulu", "Sana", "Kiel", "Ääni", "Silmä",
        "Korva", "Sydan", "Miele", "Rinn", "Huul", "Rinta",
    ],
    suffixes: ["ät", "än", "oi", "ik", "as", "es", "ot"],
    patterns: [Root, RootSuffix, PrefixRoot],
)