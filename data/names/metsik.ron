// Metsik name grammar — deep-forest Keurish naming tradition
// Sámic-calibrated invented roots: affricate-heavy (č-, š-), hushed sibilants, open finals
// Flavor: hush, resin, shade — names murmured under the canopy
NameGrammar(
    prefixes: ["čune", "šälvy", "čovi", "hyne", "vraje", "čerla", "šylvi", "muoč"],
    roots: [
        "čylvä", "šärre", "čuonna", "hyšše", "čirvo", "šlävvy",
        "večča", "čolma", "nyčče", "čävri", "šuolva", "čenny",
        "vrišša", "čolve", "häčča", "šyrme", "čukka", "luošča",
    ],
    suffixes: ["vä", "ččä", "šy", "nne", "čä", "rvo", "le"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
