// Sepät name grammar — forge/craft-naming tradition
// Roots: iron, forge, craft, hammer, anvil, spark, compound names
NameGrammar(
    prefixes: ["Rauta", "Malmi", "Takko", "Ahjo", "Hiomo", "Kova", "Terä", "Kipinä", "Pääsky", "Hämärä"],
    roots: [
        "Tako", "Vaski", "Kipinä", "Hiili", "Kynsi", "Silta", "Nokka",
        "Pääsky", "Kirves", "Vasara", "Takk", "Ahjo", "Kansi",
        "Puikko", "Silmä", "Tuli", "Säde", "Malmi", "Kaas",
        "Hohde", "Kide", "Kupari", "Peltti", "Rauta", "Taonta",
        "Valu", "Kangas", "Koukku", "Saran", "Nivel",
    ],
    suffixes: [
        "nen", "lä", "kari", "kkä", "ja", "kki", "nnen", "lä",
        "seppä", "takko", "kari", "huone", "paja", "ahjo",
    ],
    patterns: [Root, RootSuffix, PrefixRoot],
)