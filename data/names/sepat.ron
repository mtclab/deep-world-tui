// Sepät — mountain forge-folk (Oltkar family, Ugric-calibrated)
// Dense register: short hard roots, w- onsets, y vowel, -šk-/-ŋk-/-rt- clusters.
// Opaque coinages only — no dictionary words, no god-name substrings.
NameGrammar(
    prefixes: ["wyr", "tyš", "koŋ", "weš", "šur", "nyk", "wul", "pyr"],
    roots: [
        "wyrt", "tyšk", "woŋk", "kyrt", "wešk", "nyšk",
        "wošt", "pyŋk", "šyrk", "wuŋt", "kešk", "tyrš",
        "wyŋk", "pyrt", "košk", "wyšt", "tyrt", "šuŋk",
    ],
    suffixes: ["yt", "ek", "uš", "ka", "yš", "ut", "ŋi"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
