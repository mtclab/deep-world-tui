// Häl name grammar — non-human canopy people (Canopy-Isolate, not Keurish)
// Airy invented register: vowel-rich, h and l carry the word, almost no hard stops
// Names should feel like wind moving through leaves; rare glottal stop (’)
NameGrammar(
    prefixes: ["halia", "oahe", "liel", "huele", "ialo", "oula", "leiha", "hiole"],
    roots: [
        "aulo", "hieli", "oalu", "elha", "uale", "hialu",
        "oihe", "laelo", "ulia", "heano", "illau", "ohea",
        "auhe", "liolu", "halei", "uolia", "ulaho", "ea’lu",
    ],
    suffixes: ["ia", "lu", "he", "ali", "eo", "uhe", "ila"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
