// Takoväki — surface-forge folk (Oltkar family, Ugric-calibrated)
// Mixed register: sepät clusters with ahjo openness; y alongside a/o, ś palatal.
// Opaque coinages only — no dictionary words, no god-name substrings.
NameGrammar(
    prefixes: ["wyš", "tor", "šaŋ", "kaw", "nyŋ", "wor", "šek", "tyŋ"],
    roots: [
        "wyšat", "torkyt", "šaŋyr", "weškot", "kyrat", "wośket",
        "nyŋkat", "šyrot", "kawyt", "tyŋkaš", "woryš", "šekyt",
        "wartoš", "kyŋet", "myŋket", "šawyt", "toŋkar", "wešyt",
    ],
    suffixes: ["yt", "aš", "ek", "ot", "yš", "ka", "at"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
