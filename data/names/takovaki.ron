// Takoväki name grammar — surface-copper forge naming tradition
// Oltkar family: Ugric/Khanty profile with w-onset, y-vowels, final dental
// Roots: forge, copper, surface craft, trailing sound, smithing
NameGrammar(
    prefixes: ["Won", "Tako", "Rauta", "Kupari", "Pelt", "Vask", "Sul", "Ahjo"],
    roots: [
        "Won", "Śyt", "Tak", "Pää", "Vask", "Sul", "Ahjo",
        "Kupar", "Raut", "Hiili", "Pāls", "Ahjo", "Tako",
        "Nuot", "Haar", "Häm", "Isku", "Kärä", "Sula", "Val",
    ],
    suffixes: ["yt", "ot", "är", "yk", "ān", "yt", "ek"],
    patterns: [Root, RootSuffix, PrefixRoot],
)