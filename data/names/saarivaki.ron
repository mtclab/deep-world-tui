// Saariväki — Masaran island-traders (Permic-calibrated register).
// Clipped, salt-short roots (3-5); front-rounded y/ö, voiced z/d, terse -i finals.
NameGrammar(
    prefixes: ["syl", "vez", "dyl", "zai", "volz", "ydi", "lyv", "özy"],
    roots: [
        "vyzi", "ilza", "zev", "dyli", "valz", "ozi", "levd",
        "ydva", "zoli", "vidz", "ylvi", "ezvi", "dazy", "lyz",
        "vozd", "ilvy", "zydi", "evla",
    ],
    suffixes: ["zi", "vy", "di", "yl", "va", "öi", "zy"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
