// Hiekkakävelijät — Masaran sand-walkers (Permic-calibrated register).
// Drier consonant frame: k/t clusters over the family's voiced core; -i finals kept.
NameGrammar(
    prefixes: ["kyt", "tavi", "kidu", "taz", "kolt", "tyk", "vatk", "kedi"],
    roots: [
        "kytvi", "tavdi", "kotzi", "tylki", "vakti", "kidza", "tukri",
        "tedki", "katvi", "dukta", "tivka", "koldi", "tazki", "vytka",
        "tekzi", "kavti", "tydki", "atkvi",
    ],
    suffixes: ["ti", "ki", "di", "tai", "kyi", "tvi", "ka"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
