// Väylä — Masaran river-traders (Permic-calibrated register).
// Current/flow feel: v- and l-heavy, voiced z/d, flowing two-syllable roots, frequent -i finals.
NameGrammar(
    prefixes: ["vyl", "ledvi", "virze", "lazu", "völi", "delu", "zavi", "luve"],
    roots: [
        "velzi", "vildza", "luvi", "zavri", "vyldi", "voldi", "lävri",
        "vizli", "delvi", "vulza", "lyvdi", "ilvi", "vedri", "lozvi",
        "vylva", "delri", "uvzi", "zelvi",
    ],
    suffixes: ["vi", "li", "di", "zi", "väi", "ri", "la"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
