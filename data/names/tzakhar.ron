// Tzakhar — Deep people (isolate, underground stone register)
// tz-/kh- onsets, gutturals, dark vowels (a, o, u), sparse glottal-stop apostrophes.
// Opaque coinages only — no dictionary words, no god-name substrings.
NameGrammar(
    prefixes: ["tzog", "khar", "vuk", "gor", "tzu", "okh", "dur", "vak"],
    roots: [
        "tzogur", "kharod", "vukhar", "tzor’uk", "gorvak", "ukhtar",
        "tzakun", "vokhur", "khurt", "tzuvor", "akhrod", "ur’gat",
        "tzomak", "khovur", "durgak", "votzak", "khargu", "tzubak",
    ],
    suffixes: ["ak", "ur", "okh", "od", "’ut", "gar", "un"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
