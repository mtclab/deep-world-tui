// Arkit — archive scholars (Sampsaran family, Mordvinic-calibrated)
// Measured, clipped invented roots; front vowels ä/e, ś palatal, frequent -t finals.
// Opaque coinages only — no dictionary words, no god-name substrings.
NameGrammar(
    prefixes: ["vel", "mär", "ten", "śir", "erm", "verm", "mel", "ärt"],
    roots: [
        "vänet", "mervet", "śelnet", "tärmit", "veldet", "ärśet",
        "kelnit", "ternät", "miret", "esket", "värnet", "lemtet",
        "nirvet", "śimret", "etvet", "kervät", "melśit", "verśät",
    ],
    suffixes: ["et", "ät", "vet", "mit", "ent", "śet", "ne"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
