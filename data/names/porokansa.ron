// Porokansa name grammar — reindeer-herders of the cold, Keurish naming tradition
// Sámic-calibrated invented roots: back-rounded vowels (u, o), -kk- doublings,
// hoofbeat rhythm of names called across frozen ground
NameGrammar(
    prefixes: ["vuoko", "tuoku", "norku", "čukko", "šulko", "mokku", "kolvu", "urtto"],
    roots: [
        "čorkku", "vuolkka", "šuokku", "nulkko", "vorkku", "muolkku",
        "hokkva", "čunno", "šolkku", "ruolkko", "tuokku", "volkko",
        "norvvu", "kulčča", "oukko", "šurkku", "čolvvu", "vuonku",
    ],
    suffixes: ["kko", "kku", "nnu", "rvo", "ttu", "lmo", "ko"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
