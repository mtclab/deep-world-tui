// Taulukansa — tablet-scribes (Sampsaran family, Mordvinic-calibrated)
// Harder register: dense t/k stops on front vowels, clipped -t/-s finals.
// Opaque coinages only — no dictionary words, no god-name substrings.
NameGrammar(
    prefixes: ["tek", "kär", "tit", "ket", "tär", "kiv", "tet", "kir"],
    roots: [
        "tekrät", "ketkär", "terkät", "kitvet", "täkren", "ketrit",
        "tikvet", "kärtet", "tetkäs", "kivret", "täktes", "kätvet",
        "tirket", "kektär", "titvek", "kirtek", "tävket", "ketnit",
    ],
    suffixes: ["et", "ät", "kit", "te", "käs", "it", "ket"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
