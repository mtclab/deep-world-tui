// Ahjo — craft-priests (Oltkar family, Ugric-calibrated)
// More open vowels (a, o, e) than sepät; keeps w-/š- onsets and -ŋk-/-rt- clusters.
// Opaque coinages only — no dictionary words, no god-name substrings.
NameGrammar(
    prefixes: ["waŋ", "šor", "kor", "tew", "noš", "šeŋ", "wam", "tor"],
    roots: [
        "waŋket", "šorem", "kawert", "woŋar", "wertaš", "noškat",
        "šawert", "korteš", "waŋoš", "šeŋkat", "wamort", "toršek",
        "weŋal", "šokart", "naŋket", "wošker", "tewart", "šoŋket",
    ],
    suffixes: ["at", "oš", "ek", "ert", "aŋ", "ot", "eš"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
