// Ahjo name grammar — eastern forge-naming tradition
// Roots: forge-oven, mountain, ore, fire, discipline, eastern
NameGrammar(
    prefixes: ["Vuori", "Syvä", "Kova", "Itä", "Rauta", "Pimeä", "Tuli", "Harmaa", "Kuura", "Jää"],
    roots: [
        "Ahjo", "Hiili", "Malmi", "Kipinä", "Valo", "Kymi", "Kuura",
        "Tuli", "Pääsky", "Nuoli", "Peits", "Kilpi", "Miekka",
        "Kypärä", "Rauta", "Teräs", "Kivi", "Kallio", "Huippu",
        "Solmu", "Ketju", "Piippu", "Savu", "Hehku", "Hohde",
        "Liekki", "Kajo", "Säde", "Pii", "Kaas",
    ],
    suffixes: [
        "nen", "la", "kanta", "kkä", "vahdi", "alkar", "inen", "nen",
        "vuori", "kallio", "ahjo", "tuli", "kivi", "seppä",
    ],
    patterns: [Root, RootSuffix, PrefixRoot],
)