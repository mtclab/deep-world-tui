// Mëräk — intertidal sea people (non-human isolate).
// Liquid register: long doubled vowels, ä/õ, soft m/r/l; names roll like swell.
NameGrammar(
    prefixes: ["mära", "lõu", "rälõ", "mõri", "alõ", "leem", "ravä", "ulmä"],
    roots: [
        "maaril", "lõrem", "miiral", "raulim", "leemra", "õmali", "ärvel",
        "muulai", "relmä", "aaviri", "lumõra", "väälim", "oril", "ämuri",
        "luuval", "iiral", "mõlavi", "ruulam",
    ],
    suffixes: ["äk", "im", "ral", "lõi", "va", "ri", "ämi"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
