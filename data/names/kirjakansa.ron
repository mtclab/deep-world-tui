// Kirjakansa — book-people (Sampsaran family, Mordvinic-calibrated)
// Liquid register: l/r blends (-lr-, -rl-, -lv-, -rv-) on front vowels.
// Opaque coinages only — no dictionary words, no god-name substrings.
NameGrammar(
    prefixes: ["lär", "riel", "mer", "räl", "vil", "ler", "ärl", "lir"],
    roots: [
        "velrit", "lärven", "rielmä", "lervät", "merlit", "ralvet",
        "lirvet", "ärlet", "vilret", "lemrät", "rälvit", "lervis",
        "märlet", "verlit", "lärnet", "rilvät", "lirmen", "rävlit",
    ],
    suffixes: ["ät", "el", "rit", "lä", "vet", "ri", "en"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
