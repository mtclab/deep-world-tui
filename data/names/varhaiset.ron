// Varhaiset name grammar — the oldest people, archaic Keurish stratum
// Sámic-calibrated invented roots: long conservative roots, heavy consonant length (geminates)
// Flavor: weathered, slow — pre-lenition forms the younger bands no longer speak
NameGrammar(
    prefixes: ["vuony", "ärvy", "tylly", "norvy", "völly", "šuorr", "ievvä", "kolly"],
    roots: [
        "vuolnna", "šärvve", "čuorvva", "niellva", "tyrrvä", "jyvrre",
        "huolnne", "vuorrne", "lievvja", "källvo", "tuonnve", "šuollma",
        "myörrkä", "viesska", "ärvvane", "čallvy", "kuollme", "ševvni",
    ],
    suffixes: ["nnä", "vvi", "rre", "llo", "nja", "rne", "mme"],
    patterns: [Root, RootSuffix, PrefixRoot, PrefixRootSuffix],
)
