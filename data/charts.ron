// Possibility charts — STARTER (schema illustration + lore-grounded starter
// weights). Loaded at runtime (serde/RON); tune without recompiling. The exact
// serde shape is finalized by charts/load.rs (issue #3); keep this in sync.
// Weights are STARTERS — tune against deep-world-history (see GENERATION.md §5).
// Demographics note: river-corridor density; most people farm/labour; soldiers +
// merchants are minorities. Numbers are relative weights (need not sum to 1).
//
// Citations (issue #53 lore-tune pass):
// - people: deep-world-history/docs/peoples/the_peoples_who_stayed_deep_cultural_profiles.md
//   + deep-world-history/docs/peoples/population_scale_and_settlement_hierarchy.md
//   + deep-world-history/docs/peoples/race_naming_reconciliation.md
// - profession: deep-world-history/docs/culture/professions_and_trades_catalogue.md
// - craft: deep-world-history/docs/culture/craft_production_chains_from_raw_material_to_finished_good.md
// - region/settlement: deep-world-history/docs/peoples/population_scale_and_settlement_hierarchy.md
Charts(
    // ---- people (lore demographics: SAST ~15-20%, stayed ~70-80%, non-human ~5-10%) ----
    // Ref: deep-world-history docs on population_scale_and_settlement_hierarchy
    // SAST god-peoples: major civilizations, but minorities in remote regions
    // Stayed peoples: the majority common folk, per canon
    // Non-human: biome-dependent, rare in mixed settlements
    people: WeightedTable(entries: {
        // SAST god-peoples (~22% total)
        // Ref: population_scale_and_settlement_hierarchy.md §III.2 — Väylä largest, others roughly equal
        "vayla": 7, "ahjo": 6, "sepat": 5, "metsik": 5, "arkit": 5, "laakso": 4,
        // Peoples who stayed (~31% total) — weight by canon population/status
        // Ref: population_scale_and_settlement_hierarchy.md §III.3
        "varhaiset": 1,      // Extinct — only in old stories; weight 1 for schema, filtered in code
        "metsareunat": 6,    // Keurish forest-edge, moderate
        "porokansa": 3,      // Keurish tundra-reindeer, low (~35K)
        "koskimetsa": 2,     // Keurish river-rapids, endangered
        "muistikansa": 4,    // Sampsaran memory-keepers, moderate
        "taulukansa": 3,     // Sampsaran tablet-scribes, low
        "kirjakansa": 3,     // Sampsaran book-people, moderate
        "takovaki": 4,       // Oltkar surface-forge, moderate (~120K)
        "rantavaki": 5,      // Masaran shore-folk, moderate (~180K)
        "saarivaki": 3,      // Masaran island-traders, small (~55K)
        "hiekkakavelijat": 3, // Masaran sand-walkers, moderate
        "haramaki": 5,       // Kukresh steep-valley, large (~200K)
        "jamavaki": 2,       // Kukresh hidden-valley, very small (~40K)
        "pohjavaki": 2,      // Kukresh deep-bottom, small (~30K)
        // Non-human peoples (~9% total) — biome-dependent, rare in settlements
        // Ref: population_scale_and_settlement_hierarchy.md §V.2–V.6
        "tzakhar": 2, "merak": 4, "shear": 1, "hal": 1, "khor": 5,
    }),

    // ---- region / settlement (river-corridor principle) ----
    // Ref: population_scale_and_settlement_hierarchy.md — river valleys densest
    region: WeightedTable(entries: {
        "river_valley": 38, "coast": 22, "forest": 18, "upland": 12, "steppe": 6, "delta": 4,
    }),
    settlement_size: ConditionalTable(
        base: WeightedTable(entries: {
            "hamlet": 50, "village": 30, "town": 15, "city": 5,
        }),
        modifiers: [
            (when: Region("river_valley"), mult: { "village": 1.5, "town": 2.0, "city": 3.0, "hamlet": 0.5 }),
            (when: Region("coast"),        mult: { "village": 1.5, "town": 1.5, "city": 2.0 }),
            (when: Region("delta"),        mult: { "village": 1.5, "town": 2.0, "city": 2.0, "hamlet": 0.6 }),
            (when: Region("forest"),       mult: { "hamlet": 2.0, "village": 0.8, "town": 0.3, "city": 0.1 }),
            (when: Region("upland"),       mult: { "hamlet": 2.0, "village": 0.8, "town": 0.3, "city": 0.1 }),
            (when: Region("steppe"),       mult: { "hamlet": 2.5, "village": 0.7, "town": 0.2, "city": 0.05 }),
        ],
    ),

    // ---- social class ----
    // Ref: social_class_mobility_and_stratification.md — low >90%, middling <10%, high <2%
    social_class: WeightedTable(entries: { "low": 70, "middling": 25, "high": 5 }),

    // ---- profession: broad base, then conditioned (the "not 99% soldiers" core) ----
    // Ref: professions_and_trades_catalogue.md — farmers/labourers plurality, soldiers <5% globally
    profession: ConditionalTable(
        base: WeightedTable(entries: {
            "farmer": 100, "labourer": 70, "herder": 30, "fisher": 22, "forester": 18,
            "weaver": 12, "smith": 8, "carpenter": 8, "trader": 6, "miner": 6,
            "sailor": 6, "soldier": 5, "healer": 4, "herbalist": 2, "scribe": 3, "priest": 2,
            "hearth-keeper": 4, "path-finder": 3, "fence-builder": 3, "beast-handler": 2, "singer": 3,
        }),
        modifiers: [
            (when: People("sepat"),       mult: { "smith": 6.0, "miner": 4.0, "carpenter": 2.0, "farmer": 0.4 }),
            (when: People("ahjo"),        mult: { "miner": 4.0, "smith": 3.0, "soldier": 3.0, "farmer": 0.5 }),
            (when: People("vayla"),       mult: { "trader": 8.0, "sailor": 5.0, "farmer": 0.5 }),
            (when: People("metsik"),      mult: { "forester": 5.0, "herder": 2.0, "healer": 2.0 }),
            (when: People("arkit"),       mult: { "scribe": 6.0, "healer": 2.0 }),
            (when: People("laakso"),      mult: { "priest": 4.0, "herder": 2.0 }),
            // Stayed peoples profession modifiers (per canon ecology)
            (when: People("varhaiset"),    mult: { "herder": 4.0, "farmer": 0.3, "labourer": 2.0 }),
            (when: People("metsareunat"), mult: { "forester": 4.0, "herder": 2.0, "trader": 1.5 }),
            (when: People("porokansa"),   mult: { "herder": 6.0, "forester": 2.0, "farmer": 0.1 }),
            (when: People("koskimetsa"),  mult: { "fisher": 5.0, "forester": 3.0, "carpenter": 1.5 }),
            (when: People("muistikansa"), mult: { "scribe": 4.0, "healer": 3.0, "priest": 2.0 }),
            (when: People("taulukansa"),  mult: { "scribe": 3.0, "carpenter": 2.0, "smith": 1.5 }),
            (when: People("kirjakansa"), mult: { "scribe": 4.0, "trader": 2.0, "healer": 1.5 }),
            (when: People("takovaki"),   mult: { "smith": 5.0, "miner": 3.0, "carpenter": 1.5, "farmer": 0.3 }),
            (when: People("rantavaki"),  mult: { "fisher": 5.0, "farmer": 2.0, "trader": 1.5 }),
            (when: People("saarivaki"),  mult: { "sailor": 6.0, "trader": 5.0, "fisher": 3.0 }),
            (when: People("hiekkakavelijat"), mult: { "fisher": 3.0, "trader": 4.0, "herder": 1.5, "farmer": 0.3 }),
            (when: People("haramaki"),   mult: { "farmer": 3.0, "herder": 2.0, "labourer": 2.0 }),
            (when: People("jamavaki"),   mult: { "herder": 3.0, "healer": 2.0, "priest": 2.0 }),
            (when: People("pohjavaki"),  mult: { "miner": 3.0, "herder": 2.0, "forester": 2.0 }),
            // Non-human peoples profession modifiers
            (when: People("tzakhar"),   mult: { "miner": 5.0, "forester": 2.0, "labourer": 3.0, "farmer": 0.01, "trader": 0.1 }),
            (when: People("merak"),     mult: { "sailor": 6.0, "fisher": 5.0, "trader": 4.0, "farmer": 0.01 }),
            (when: People("shear"),    mult: { "smith": 3.0, "labourer": 4.0, "farmer": 0.2, "herder": 2.0 }),
            (when: People("hal"),       mult: { "forester": 5.0, "herder": 3.0, "healer": 2.0, "farmer": 0.1 }),
            (when: People("khor"),     mult: { "herder": 4.0, "labourer": 3.0, "priest": 2.0, "farmer": 0.1 }),
            (when: Region("coast"),       mult: { "fisher": 4.0, "sailor": 3.0, "farmer": 0.6 }),
            (when: Region("forest"),      mult: { "forester": 4.0, "herder": 1.5, "farmer": 0.7 }),
            (when: Region("upland"),      mult: { "miner": 3.0, "herder": 2.0, "farmer": 0.6 }),
            (when: Class("low"),          mult: { "scribe": 0.1, "priest": 0.2, "trader": 0.4 }),
            (when: Class("high"),         mult: { "scribe": 4.0, "trader": 3.0, "labourer": 0.1, "soldier": 2.0 }),
            (when: Settlement("city"),    mult: { "trader": 3.0, "scribe": 2.0, "smith": 1.5, "farmer": 0.2 }),
        ],
    ),

    // ---- craft affinity (rare; "none" dominates) ----
    // Ref: craft_production_chains — Arkit→word, Väylä→current, Laakso→still, Sepät/Ahjo→forge, Metsik→root
    craft_affinity: ConditionalTable(
        base: WeightedTable(entries: { "none": 100, "word": 2, "current": 2, "still": 2, "forge": 2, "root": 2, "tanner": 1, "rope_maker": 1, "charcoal_burner": 1, "falconer": 1, "salt_miner": 1, "reed_weaver": 1 }),
        modifiers: [
            (when: People("arkit"),  mult: { "word": 6.0 }),
            (when: People("vayla"),  mult: { "current": 6.0 }),
            (when: People("laakso"), mult: { "still": 6.0 }),
            (when: People("sepat"),  mult: { "forge": 6.0 }),
            (when: People("ahjo"),   mult: { "forge": 4.0 }),
            (when: People("metsik"), mult: { "root": 6.0 }),
            // Stayed peoples craft affinities
            (when: People("varhaiset"),   mult: { "root": 3.0 }),
            (when: People("metsareunat"), mult: { "root": 4.0 }),
            (when: People("porokansa"),  mult: { "root": 3.0, "still": 2.0 }),
            (when: People("koskimetsa"), mult: { "current": 3.0, "root": 2.0 }),
            (when: People("muistikansa"), mult: { "word": 5.0 }),
            (when: People("taulukansa"),  mult: { "word": 4.0, "forge": 2.0 }),
            (when: People("kirjakansa"),  mult: { "word": 5.0, "current": 2.0 }),
            (when: People("takovaki"),   mult: { "forge": 5.0 }),
            (when: People("rantavaki"),   mult: { "current": 4.0 }),
            (when: People("saarivaki"),   mult: { "current": 5.0 }),
            (when: People("hiekkakavelijat"), mult: { "current": 3.0 }),
            (when: People("haramaki"),   mult: { "still": 3.0, "forge": 2.0 }),
            (when: People("jamavaki"),   mult: { "still": 5.0 }),
            (when: People("pohjavaki"),  mult: { "still": 4.0, "root": 2.0 }),
            // Non-human craft affinities
            (when: People("tzakhar"),  mult: { "still": 4.0, "forge": 3.0 }),
            (when: People("merak"),    mult: { "current": 5.0 }),
            (when: People("shear"),    mult: { "forge": 4.0 }),
            (when: People("hal"),      mult: { "root": 5.0 }),
            (when: People("khor"),     mult: { "still": 5.0, "word": 3.0 }),
        ],
    ),

    // ---- personality: a small tag set (sample 2-3) + per-people value leanings ----
    personality_traits: WeightedTable(entries: {
        "stoic": 10, "warm": 10, "proud": 8, "cautious": 9, "reckless": 6, "devout": 6,
        "mercenary": 6, "loyal": 9, "bitter": 5, "curious": 7, "withdrawn": 6, "shrewd": 7,
        "suspicious": 7, "cheerful": 8, "boisterous": 5, "melancholic": 6, "devious": 5, "earnest": 8, "world-weary": 5,
    }),

    // ---- household (the consequence hooks) ----
    has_spouse: WeightedTable(entries: { "yes": 55, "no": 45 }),
    children_count: WeightedTable(entries: { "0": 45, "1": 22, "2": 18, "3": 10, "4+": 5 }),
    has_debt: WeightedTable(entries: { "no": 70, "yes": 30 }),

    // ---- age / sex ----
    age_band: WeightedTable(entries: { "child": 0, "youth": 22, "adult": 50, "elder": 18, "aged": 10 }),
    sex: WeightedTable(entries: { "f": 50, "m": 50 }),

    // ---- name grammars per people: pointer to data/names/<people>.ron (issue #4) ----
    // Generated from the lore Naming Atlas/Guide; names MUST fit the sampled people.
    name_grammars: {
        "metsik": "names/metsik.ron", "arkit": "names/arkit.ron",
        "vayla": "names/vayla.ron", "laakso": "names/laakso.ron",
        "sepat": "names/sepat.ron", "ahjo": "names/ahjo.ron",
        "tzakhar": "names/tzakhar.ron", "merak": "names/merak.ron",
        "shear": "names/shear.ron", "hal": "names/hal.ron",
        "khor": "names/khor.ron",
        // Stayed peoples name grammars
        "varhaiset": "names/varhaiset.ron",
        "metsareunat": "names/metsareunat.ron",
        "porokansa": "names/porokansa.ron",
        "koskimetsa": "names/koskimetsa.ron",
        "muistikansa": "names/muistikansa.ron",
        "taulukansa": "names/taulukansa.ron",
        "kirjakansa": "names/kirjakansa.ron",
        "takovaki": "names/takovaki.ron",
        "rantavaki": "names/rantavaki.ron",
        "saarivaki": "names/saarivaki.ron",
        "hiekkakavelijat": "names/hiekkakavelijat.ron",
        "haramaki": "names/haramaki.ron",
        "jamavaki": "names/jamavaki.ron",
        "pohjavaki": "names/pohjavaki.ron",
    },

    // ---- world structure (issue #24) ----
    region_count: WeightedTable(entries: { "3": 5, "4": 10, "5": 20, "6": 25, "7": 20, "8": 10, "9": 5, "10": 5 }),
    settlements_per_region: ConditionalTable(
        base: WeightedTable(entries: { "1": 5, "2": 15, "3": 25, "4": 25, "5": 15, "6": 10, "7": 5 }),
        modifiers: [
            (when: Region("river_valley"), mult: { "4": 2.0, "5": 2.0, "6": 2.0, "7": 3.0 }),
            (when: Region("coast"),         mult: { "4": 1.5, "5": 2.0, "6": 2.0 }),
            (when: Region("forest"),        mult: { "1": 3.0, "2": 2.0, "3": 1.5, "6": 0.3, "7": 0.1 }),
            (when: Region("upland"),        mult: { "1": 2.0, "2": 2.0, "3": 1.5, "6": 0.3, "7": 0.1 }),
            (when: Region("steppe"),         mult: { "1": 2.0, "2": 2.0, "3": 1.0, "5": 0.3, "6": 0.1 }),
            (when: Region("delta"),          mult: { "3": 1.5, "4": 2.0, "5": 2.0, "6": 1.5 }),
        ],
    ),
    // population = sampled tier value (persons). Dense regions get higher tiers.
    population_tier: ConditionalTable(
        base: WeightedTable(entries: {
            "20": 20, "40": 18, "60": 15, "80": 12, "100": 10,
            "150": 8, "200": 5, "300": 3, "500": 2, "800": 1,
        }),
        modifiers: [
            (when: Settlement("hamlet"),  mult: { "20": 4.0, "40": 3.0, "60": 2.0, "300": 0.1, "500": 0.01, "800": 0.01 }),
            (when: Settlement("village"),  mult: { "40": 1.5, "60": 2.0, "80": 2.0, "100": 2.0, "150": 1.5 }),
            (when: Settlement("town"),     mult: { "100": 1.0, "150": 2.0, "200": 3.0, "300": 3.0, "500": 2.0 }),
            (when: Settlement("city"),     mult: { "200": 1.0, "300": 2.0, "500": 4.0, "800": 5.0 }),
            (when: Region("river_valley"), mult: { "80": 1.5, "100": 2.0, "150": 2.0, "200": 2.0, "300": 2.0 }),
            (when: Region("coast"),        mult: { "80": 1.5, "100": 1.5, "150": 1.5, "200": 1.5 }),
            (when: Region("forest"),       mult: { "20": 3.0, "40": 2.0, "500": 0.1, "800": 0.01 }),
            (when: Region("upland"),       mult: { "20": 2.0, "40": 2.0, "500": 0.1, "800": 0.01 }),
        ],
    ),
    // ---- region subtypes: conditional on region type ----
    region_subtypes: ConditionalTable(
        base: WeightedTable(entries: { "generic": 10 }),
        modifiers: [
            (when: Region("river_valley"), mult: { "flood_plain": 30, "gorge": 15, "estuary": 20, "broad_valley": 25, "rapids_valley": 10 }),
            (when: Region("coast"),        mult: { "cliff_coast": 20, "bay": 25, "harbor_coast": 30, "tidal_flat": 15, "archipelago": 10 }),
            (when: Region("forest"),       mult: { "deep_wood": 30, "pine_forest": 25, "swamp_forest": 15, "ancient_growth": 20, "cleared_woodland": 10 }),
            (when: Region("upland"),       mult: { "highland": 30, "mountain": 20, "plateau": 25, "craggy_ridge": 15, "alpine_meadow": 10 }),
            (when: Region("steppe"),       mult: { "grassland": 35, "scrubland": 25, "dry_plains": 20, "wind_swept_flat": 15, "steppe_lake": 5 }),
            (when: Region("delta"),        mult: { "marsh": 30, "islands": 25, "reed_maze": 20, "tidal_delta": 15, "silt_flat": 10 }),
        ],
    ),
    // ---- settlement name suffixes per region type ----
    settlement_suffixes: {
        // Place-name finals: invented, branch-calibrated (Diverse-Branch
        // Opacity baseline) — places may carry god-names, peoples may not.
        "river_valley": ["vuod", "jovk", "šora", "ävri", "kärd", "vonsa", "ojva", "luma"],
        "coast":        ["luov", "vuodn", "ulva", "ažva", "kõlda", "vir’a", "säri", "njarg"],
        "forest":       ["vuow", "čähl", "lešna", "ohta", "vyrre", "šuol", "hapse", "kärvo"],
        "upland":       ["čokk", "urtta", "paut", "vuorč", "halst", "kamč", "ylde", "rokka"],
        "steppe":       ["ärte", "kavda", "tolva", "šara", "vetlu", "orda", "hövd", "myld"],
        "delta":        ["ńur", "važa", "saiva", "lomp", "ažu", "vuom", "lutva", "ńäšk"],
    },
    // ---- region description templates per region type ----
    region_descriptions: {
        "river_valley": ["Old waystones of the Pilgrimage Road cross the valley floor, mile on mile, pointing at nothing.", "Bridge-stumps stand in the current — the Fall took the span, the river kept the piers.", 
            "Fertile lowlands hugging a broad river",
            "Rich alluvial plains with winding waterways",
            "A well-watered corridor between hills",
            "Muddy banks and verdant fields stretch along the river",
            "Fish-houses line the slow bend of deep water",
        ],
        "coast": ["On clear days the Tähti shipping lanes show as sails strung along the horizon of the Inland Sea.", "A toll-post of some harbor confederation stands at the headland, painted, manned, and argued about.", 
            "A windswept coastline with rocky harbours",
            "Sheltered bays and tidal flats",
            "Salt-washed shores where fisher-folk dwell",
            "White cliffs rise above a narrow strand of sand",
            "Nets dry in the salt breeze along the boardwalk",
        ],
        "forest": ["The forest edge here grows back strange over old burned ground, the way they say it does at Kaelva.", "A carved lantern-post leans by the path — the old forest roads were marked so, and kept off every map.", 
            "Dense old-growth forest with scattered clearings",
            "Shadowed woods where ancient roots run deep",
            "A vast woodland broken by narrow trails",
            "Canopy so thick the sky is only memory",
            "Moss and fern claim every fallen trunk",
        ],
        "upland": ["The high passes carry mountain trade the way they have since the elevator at Oltzafell first turned.", "Toll-cairns of three forgotten polities stand within a day of each other, each claiming the same pass.", 
            "Rocky highlands with thin soil and hardy folk",
            "Wind-swept ridges above the treeline",
            "Crags and meadows alternating under grey skies",
            "Sheep paths wind between granite shoulders",
            "Thin air and long shadows define the high places",
        ],
        "steppe": ["Herd-tracks braid the grass to the horizon; the steppe tribes follow them as their grandmothers did.", "A waystation of the old imperial route stands roofless here, its message-register stopped mid-line.", 
            "Grass ocean stretching to a pale horizon",
            "Endless plains where herders follow the seasons",
            "Open grassland with scattered watering holes",
            "Wind hums through tall grass, world without end",
            "A solitary tree marks the only shade for a day's walk",
        ],
        "delta": ["The leagues of the river basin settled their toll war in these marshes, and the channel-stakes still show it.", "Reed-cutters trade salt and rumor with the coast; the Fall never quite reached this far into the mud.", 
            "Labyrinthine waterways and reed-bound islets",
            "A shifting mosaic of silt and tide",
            "Marshy lowlands where river meets sea",
            "Boats weave between silt islands under grey sky",
            "Reed walls and drifting fog hide the channels",
        ],
    },
)
