(
    metsik: (
        greetings: [
            "\"The forest remembers. Walk freely among us.\"",
            "\"A fellow traveler! The pines whisper your coming.\"",
            "\"Welcome under the canopy. The paths are many here.\"",
            "\"Keuru's shade on you. What winds bring you here?\"",
            "\"The old trees know your step. Come, rest.\"",
        ],
        farewells: [
            "\"May the roots hold your path steady.\"",
            "\"The forest watches until we meet again.\"",
            "\"Go with Keuru's warmth. The glade awaits your return.\"",
            "\"Until the next gathering under the eaves.\"",
            "\"The moss will remember your passing. Walk well.\"",
        ],
        neutral: [
            "\"The pines shift in the wind. Change is always coming.\"",
            "\"We Metsik carry no heavy iron, only light hearts.\"",
            "\"The forest provides. One must only learn to listen.\"",
            "\"Each season teaches. We are slow to forget.\"",
            "\"The river says patience. The hawk says now. We learn from both.\"",
        ],
    ),
    arkit: (
        greetings: [
            "\"The Archive awaits. What knowledge do you seek?\"",
            "\"A reasoned welcome. The catalogs are ordered this morning.\"",
            "\"Sampsa's light on you. The records are open.\"",
            "\"Fortuitous timing. We just catalogued a new finding.\"",
            "\"Welcome. The shelves hold much; ask and you shall find.\"",
        ],
        farewells: [
            "\"May Sampsa preserve your memory. Return soon.\"",
            "\"The Archive endures. So shall we meet again.\"",
            "\"Knowledge does not decay. Until next time.\"",
            "\"Go carefully. What you learn here is weight enough.\"",
            "\"The catalogues will be here when you return.\"",
        ],
        neutral: [
            "\"We Arkit preserve what others forget. This is our burden and gift.\"",
            "\"The Archive is vast. One must learn what to seek, not merely what to find.\"",
            "\"Memory is the greatest technology. Everything else is application.\"",
            "\"Records show this has happened before. It will happen again.\"",
            "\"A fact without context is merely noise. We provide the context.\"",
        ],
    ),
    vayla: (
        greetings: [
            "\"Fair trade to you! The river brought goods this morning.\"",
            "\"Masa's grace on your path. What can the Väylá offer?\"",
            "\"Welcome, welcome! The tides are favorable today.\"",
            "\"A traveler! The river roads connect all peoples.\"",
            "\"Good current today. That means good business.\"",
        ],
        farewells: [
            "\"May Masa weigh your path favorably.\"",
            "\"Fair winds until we trade again.\"",
            "\"The river flows on. So shall we meet once more.\"",
            "\"Watch the current — it carries fortune and trouble alike.\"",
            "\"Until the next market day. Trade well.\"",
        ],
        neutral: [
            "\"The Väylá know the worth of everything. Ask anyone.\"",
            "\"Patience and persistence — the river teaches both.\"",
            "\"Trade builds trust. Trust builds peace. Peace builds trade.\"",
            "\"Every coin has two sides. We know which one faces up.\"",
            "\"The current never stops, and neither should those who ride it.\"",
        ],
    ),
    laakso: (
        greetings: [
            "\"Stillness finds you. Sit, if you wish.\"",
            "\"Kukri's quiet on you. The depths hold patience.\"",
            "\"You are welcome in stillness. There is no hurry here.\"",
            "\"The valley breathes slowly. You may too.\"",
            "\"The quiet does not mean emptiness. Quite the opposite.\"",
        ],
        farewells: [
            "\"May Kukri's stillness accompany your steps.\"",
            "\"Go quietly. The world is loud enough without us adding to it.\"",
            "\"The valley will be here when you return. It always is.\"",
            "\"Quiet steps carry far. Walk gently.\"",
            "\"We part in silence. That is Laakso's way.\"",
        ],
        neutral: [
            "\"The Laakso do not rush. What comes, comes.\"",
            "\"In silence, understanding grows. In noise, it scatters.\"",
            "\"The old wisdom is quiet wisdom. Listen more than you speak.\"",
            "\"Patience is not waiting. Patience is understanding the timing.\"",
            "\"What is truly important does not need to be said loudly.\"",
        ],
    ),
    sepat: (
        greetings: [
            "\"Oltzed's forge burn warm today. Welcome.\"",
            "\"The iron does not wait, but we have a moment.\"",
            "\"A firm handshake. The Sepät recognize strength.\"",
            "\"The forge is hot and the work is honest. Come in.\"",
            "\"Iron and fire. What else does one need? Welcome.\"",
        ],
        farewells: [
            "\"Oltzed hold what you build. Walk strong.\"",
            "\"The forge coals wait for no one. Nor should you. Farewell.\"",
            "\"May your steel stay sharp and your bonds hold true.\"",
            "\"The anvil does not mourn the finished work. Go well.\"",
            "\"Iron remembers. We Sepät do not forget our friends.\"",
        ],
        neutral: [
            "\"The Sepät trust what they can hold and what holds under stress.\"",
            "\"A good forge teaches patience. Iron cannot be rushed.\"",
            "\"What bends without breaking is stronger than what never bends.\"",
            "\"Craft is the truest form of respect. Show me your hands.\"",
            "\"The world is built on what we forge — both metal and trust.\"",
        ],
    ),
    ahjo: (
        greetings: [
            "\"The sacred flame burns bright. You are welcome.\"",
            "\"Oltzed's blessing on this meeting. The forge-rites are done.\"",
            "\"Strength and purpose. What brings you to the Ahjo?\"",
            "\"The inner fire recognizes a kindred spark.\"",
            "\"We Ahjo tend both hearth and forge. Be welcome.\"",
        ],
        farewells: [
            "\"May Oltzed's fire light your way.\"",
            "\"The sacred flame endures. So shall our bond.\"",
            "\"Walk with purpose. The Ahjo do not wander.\"",
            "\"Strength endures. Come back with it.\"",
            "\"The hearth-fire waits for your return.\"",
        ],
        neutral: [
            "\"The Ahjo understand that sacred fire refines, not merely burns.\"",
            "\"Iron becomes steel through ordeal. People become stronger the same way.\"",
            "\"The forge-fire teaches: what doesn't bend, breaks. What bends, endures.\"",
            "\"Our rituals are not empty. They bind what iron alone cannot.\"",
            "\"A bond forged in fire is stronger than any made in comfort.\"",
        ],
    ),
    varhaiset: (
        greetings: [
            "\"All Five walked these lands before the peoples. Welcome.\"",
            "\"We have seen much. The first paths are still visible, if you know where to look.\"",
            "\"Traveler from elsewhere. The headwaters remember all who pass.\"",
            "\"The oldest ways are still good ways. Welcome.\"",
            "\"We Varhaiset watched the gods depart and return. Walk freely.\"",
        ],
        farewells: [
            "\"The Five watch all who travel. Go in their many eyes.\"",
            "\"The first road leads back. We will meet again.\"",
            "\"May all Five guide your path — each in their season.\"",
            "\"Headwaters flow down, always down. But they remember the heights.\"",
            "\"Until the next turning of the old calendar.\"",
        ],
        neutral: [
            "\"We Varhaiset honor all Five — no single god owns our hearth.\"",
            "\"The first paths were walked before people had names for the gods.\"",
            "\"Who we were before has bearing on who we choose to be.\"",
            "\"The highlands do not change quickly. Neither do we.\"",
            "\"Old blood carries old memories. We listen to them.\"",
        ],
    ),
    metsareunat: (
        greetings: [
            "\"The forest-edge bids you welcome. Keuru watches from the canopy.\"",
            "\"Where the trees end and the fields begin — that is our place. Welcome.\"",
            "\"The border teaches adaptation. You seem adaptable.\"",
            "\"Forest and field both give. We know how to listen to each.\"",
            "\"The edge is where change happens. Even greetings are different here.\"",
        ],
        farewells: [
            "\"The forest and field each have their paths. Walk whichever calls.\"",
            "\"May Keuru's canopy shelter what the field cannot.\"",
            "\"Where two worlds meet, a third is born. Farewell from that third.\"",
            "\"The edge goes both ways. Come back from either direction.\"",
            "\"Between forest and field, we stand. Go steady.\"",
        ],
        neutral: [
            "\"The Metsäreunat know both worlds — forest wild and field cultivated.\"",
            "\"Adaptation is not weakness. It is the edge-people's greatest craft.\"",
            "\"Every season shifts the line. We shift with it.\"",
            "\"The deer knows the meadow. The deer knows the forest. We are the deer.\"",
            "\"Border wisdom: respect what lies on both sides.\"",
        ],
    ),
    porokansa: (
        greetings: [
            "\"The herd moves; we follow. Welcome from the open tundra.\"",
            "\"Keuru's creatures led us here. You are among friends.\"",
            "\"A traveler! The reindeer sense friend from foe. You pass the test.\"",
            "\"The grass is good here. For herds and for people alike.\"",
            "\"The Porokansa welcome those who respect the animal ways.\"",
        ],
        farewells: [
            "\"The herd calls. May Keuru guide your migration.\"",
            "\"Until the pastures meet again.\"",
            "\"Walk as the reindeer walk — sure and steady.\"",
            "\"We follow the seasons, not the paths. We will meet where the grass grows.\"",
            "\"Keuru's creatures watch over travelers. Go safely.\"",
        ],
        neutral: [
            "\"The Porokansa follow where the reindeer lead. They have never failed us.\"",
            "\"Patience. A herd that rushes scatters. A herd that waits arrives together.\"",
            "\"The tundra teaches: there is no wasted movement when survival depends on each step.\"",
            "\"We know every hill by name and every stream by taste.\"",
            "\"The animal ways are the old ways. Trust them.\"",
        ],
    ),
    koskimetsa: (
        greetings: [
            "\"The rapids sing and the forest answers. Welcome to the crossing.\"",
            "\"Where water meets wood — that is our home. You are welcome in it.\"",
            "\"Keuru watches from the trees; the current speaks below. Listen to both.\"",
            "\"A traveler! The rapids bring news from both directions.\"",
            "\"The Koskimetsä know every rock in the stream. Step carefully, stay safe.\"",
        ],
        farewells: [
            "\"May the current carry you true, and the canopy keep you dry.\"",
            "\"The river flows on. So shall we meet again.\"",
            "\"Keuru's forest and Keuru's river — both will remember you.\"",
            "\"Watch the water level. It changes faster than the trees.\"",
            "\"The crossing endures. We will be here.\"",
        ],
        neutral: [
            "\"The Koskimetsä live between two forces — current and canopy — and respect both.\"",
            "\"A river teaches: go around obstacles when you can, through them when you must.\"",
            "\"The forest and the rapids both speak. We have learned both languages.\"",
            "\"Wood and water: the two oldest teachers. We listen.\"",
            "\"The best crossings are quiet ones. Plan first, move second.\"",
        ],
    ),
    muistikansa: (
        greetings: [
            "\"The old words are the truest words. Welcome.\"",
            "\"Sampsa's memory preserves all. What do you carry with you?\"",
            "\"A visitor! The songs are ready, if you wish to hear.\"",
            "\"The Muistikansa remember. Even what you have forgotten.\"",
            "\"The oral tradition is not imprecise. It is precise differently.\"",
        ],
        farewells: [
            "\"Sampsa keep your memory sharp. The stories will wait.\"",
            "\"We remember even the farewells. You will not be forgotten.\"",
            "\"The old paths are still sung. Walk to their rhythm.\"",
            "\"Go well. The next song may include your name.\"",
            "\"Memory endures. Come back when you are ready.\"",
        ],
        neutral: [
            "\"The Muistikansa carry what books forgot. We are the living Archive.\"",
            "\"A song lasts longer than a page. We know this from experience.\"",
            "\"What is memorized is internalized. What is written is externalized. Both matter.\"",
            "\"The old stories contain warnings we have already forgotten the context for.\"",
            "\"We do not write history. We sing it. The difference matters.\"",
        ],
    ),
    taulukansa: (
        greetings: [
            "\"The tablets hold what memory cannot. Welcome to Sampsari ground.\"",
            "\"A visitor! The independent scribes have noted your arrival.\"",
            "\"Sampsa's clarity guide us. What questions do you bring?\"",
            "\"The Taulukansa write their own records, not the Arkit's version.\"",
            "\"Knowledge without independence is merely obedience. Welcome.\"",
        ],
        farewells: [
            "\"May Sampsa's clarity light your path forward.\"",
            "\"The tablets will record this meeting. Good or ill, it is written.\"",
            "\"Independence of thought, clarity of record. Go with both.\"",
            "\"The Taulukansa do not forget. Farewell.\"",
            "\"Write your own path forward. The tablets will observe.\"",
        ],
        neutral: [
            "\"The Taulukansa trust tablets over tales. Ink does not embellish.\"",
            "\"Independence in scholarship is independence in everything else.\"",
            "\"The best records are the ones no one asked you to write.\"",
            "\"We are scribes, not servants. There is a difference.\"",
            "\"Clarity is the highest form of respect for the truth.\"",
        ],
    ),
    kirjakansa: (
        greetings: [
            "\"The book awaits. Welcome to the river-valley scripts.\"",
            "\"Sampsa's ink flows through us. What do you seek?\"",
            "\"A welcome among pages. The river-valley scribes have time for visitors.\"",
            "\"The Kirjakansa see the world through words. You read clearly today.\"",
            "\"Knowledge has a current, like the river. Follow it here.\"",
        ],
        farewells: [
            "\"May Sampsa's pages turn in your favor.\"",
            "\"The ink dries, but the words remain. Until next reading.\"",
            "\"What is written does not fade. We will remember you.\"",
            "\"Go with knowledge. It is the lightest burden.\"",
            "\"The book closes for now. The story continues elsewhere.\"",
        ],
        neutral: [
            "\"The Kirjakansa bind what the Arkit catalog. Different crafts, same purpose.\"",
            "\"A river-valley scribe knows: good ink is worth more than gold.\"",
            "\"The written word travels farther than the spoken. We count on this.\"",
            "\"Every book is a river the reader can cross at any point.\"",
            "\"We copy, we translate, we preserve. The craft is modest; the effect is vast.\"",
        ],
    ),
    takovaki: (
        greetings: [
            "\"The surface copper gleams. Oltzed's forge-warms on you.\"",
            "\"The Takoväki know the metals above. Welcome to the surface forge.\"",
            "\"Copper before iron, always. What do you need?\"",
            "\"The forge-fire is not for deep caves. It is for sunlit work.\"",
            "\"Oltzed taught us surface craft. We honor every strike.\"",
        ],
        farewells: [
            "\"May Oltzed keep your tools sharp and your copper bright.\"",
            "\"The surface forge cools quickly. Come back before it does.\"",
            "\"Copper endures. So does craftsmanship. Farewell.\"",
            "\"The sun on copper is the greatest anvil. Walk in light.\"",
            "\"The Takoväki forge on. So should you.\"",
        ],
        neutral: [
            "\"The Takoväki work surface metals — copper, brass, bronze. We do not go deep.\"",
            "\"Copper conducts more than heat. It connects peoples.\"",
            "\"Surface craft is no lesser craft. The Tzakhar know this; we disagree on method.\"",
            "\"The forge is our temple. Oltzed is our patron. Both are honored equally.\"",
            "\"What we shape above ground lasts as long as what Tzakhar shape below.\"",
        ],
    ),
    rantavaki: (
        greetings: [
            "\"The tide has brought you. Masa's current carries fortune.\"",
            "\"Welcome to the shore. The vats are full today.\"",
            "\"A visitor! The Rantaväki have salt and patience in equal measure.\"",
            "\"The pools are productive. A good day for meeting.\"",
            "\"Masa's favor: calm water, full nets. What about yours?\"",
        ],
        farewells: [
            "\"May Masa's current bring you to good harbor.\"",
            "\"The tide goes out, but always returns. As shall you.\"",
            "\"The shoreline will be here. Walk it when you can.\"",
            "\"Fair tides. The Rantaväki will watch for your sail.\"",
            "\"The vats need tending. Go well.\"",
        ],
        neutral: [
            "\"The Rantaväki know the shore — every tide pool, every current, every storm.\"",
            "\"Patience and salt: the two things the sea teaches best.\"",
            "\"What the sea gives, it can take back. We respect the debt.\"",
            "\"The vats produce what the land cannot. This is our gift to all peoples.\"",
            "\"Trade by the shore is trade at the edge of the world. No further to go.\"",
        ],
    ),
    saarivaki: (
        greetings: [
            "\"The island welcomes you. Masa's deepest waters protect these shores.\"",
            "\"A boat-farer! The Saariväki know all the channels. Welcome.\"",
            "\"The inland sea is calm today. Good for visitors.\"",
            "\"Masa's trade routes brought you here. The islands honor this.\"",
            "\"From island to island, word travels fast. We already know your name.\"",
        ],
        farewells: [
            "\"May Masa's depths carry your vessel true.\"",
            "\"The island waits. Come back when the current shifts.\"",
            "\"Sail well. The Saariväki watch from every island.\"",
            "\"The inland sea connects all our islands. We are always neighbors.\"",
            "\"Fair winds and following seas.\"",
        ],
        neutral: [
            "\"The Saariväki trade across water. Distance is merely a matter of patience.\"",
            "\"Every island has its own wind-pattern. We learn them all.\"",
            "\"The sea connects what the land separates. This is the island-folk's truth.\"",
            "\"One market per island, one sea shared by all. The math is simple.\"",
            "\"Trust the current, respect the storm. This is Masa's teaching.\"",
        ],
    ),
    hiekkakavelijat: (
        greetings: [
            "\"The sand shifts but we remain. Welcome from the beach-ridges.\"",
            "\"Masa sees trade even in sand. What brings you to the lagoons?\"",
            "\"The Hiekkakävelijät walk where others sink. Welcome to firm ground.\"",
            "\"The lagoon water is clear today. Good for trading.\"",
            "\"Salt and sand, fish and patience. All we need. You are welcome to both.\"",
        ],
        farewells: [
            "\"May the tide pools stay full and the sand stay firm beneath you.\"",
            "\"The lagoons will be here. Walk the ridges back anytime.\"",
            "\"Masa's favor: may your path be solid.\"",
            "\"The Hiekkakävelijät walk on. So should you.\"",
            "\"From ridge to lagoon, farewell.\"",
        ],
        neutral: [
            "\"The Hiekkakäveliját know: sand reveals everything eventually.\"",
            "\"The lagoon provides, but never abundantly. We learn precise gratitude.\"",
            "\"Beach-ridge life teaches: what appears solid may shift. What appears empty may be full.\"",
            "\"We walk the line between sea and land. Both teach us.\"",
            "\"The sand does not judge. Neither do we — until given reason.\"",
        ],
    ),
    haramaki: (
        greetings: [
            "\"The terraces hold. Welcome to the steep valleys, stranger.\"",
            "\"Kukri's shade finds you. The dry ground welcomes.\"",
            "\"A visitor in the hills. The Haramäki grow where others cannot.\"",
            "\"The terraces are our answer to hunger. Welcome to proven ground.\"",
            "\"Patience grows everything. Even a greeting from a stranger.\"",
        ],
        farewells: [
            "\"May Kukri's shade find you in dry places.\"",
            "\"The terraces endure. So shall our memory of you.\"",
            "\"Climb safely. The valleys are steep but the views are clear.\"",
            "\"Dry ground. Still heart. Until next time.\"",
            "\"The Haramäki wait. We always wait.\"",
        ],
        neutral: [
            "\"The Haramäki know: steep ground teaches careful steps.\"",
            "\"Dry terrace farming requires patience that lowland people cannot imagine.\"",
            "\"What grows in scarcity grows stronger. This is our truth.\"",
            "\"The valley walls echo. We have learned to listen to the echoes.\"",
            "\"Kukri teaches solitude. We practice community. Both have value.\"",
        ],
    ),
    jamavaki: (
        greetings: [
            "\"Stillness greets you. The hidden valleys are quiet, as always.\"",
            "\"Kukri's wisdom in the silence. Welcome.\"",
            "\"The Jämäväki speak softly. Listen carefully.\"",
            "\"A rare visitor. The hidden valleys see few strangers.\"",
            "\"We value silence. But a welcome does not require volume.\"",
        ],
        farewells: [
            "\"Go in silence. It carries farther than you think.\"",
            "\"Kukri's quiet walk with you.\"",
            "\"The hidden valleys will be here. We ask nothing more.\"",
            "\"Silent steps. Watchful eyes. Until we meet again.\"",
            "\"What is said quietly is remembered longest. Farewell.\"",
        ],
        neutral: [
            "\"The Jämäväki chose solitude over noise. We do not regret it.\"",
            "\"A hidden valley is not a prison. It is a sanctuary.\"",
            "\"Silence is not absence. It is presence without performance.\"",
            "\"The old wisdom comes from old quiet. We keep both.\"",
            "\"Kukri does not demand worship. Only attention. We give it.\"",
        ],
    ),
    pohjavaki: (
        greetings: [
            "\"From the deep places, welcome. The Pohjaväki see more than we say.\"",
            "\"Kukri's deep patience. You have come far.\"",
            "\"The depths are quiet, but not empty. Welcome, surface-dweller.\"",
            "\"What the deep sees, the deep keeps. Your secrets are safe.\"",
            "\"The Pohjaväki observe. Even here, we observe.\"",
        ],
        farewells: [
            "\"May Kukri's deep silence accompany you.\"",
            "\"The depths remember. We will remember you.\"",
            "\"Surface winds are louder than deep currents. Walk in quiet.\"",
            "\"The Pohjaväki do not say farewell. We simply note your absence.\"",
            "\"What is seen in the deep stays in the deep. Go safely.\"",
        ],
        neutral: [
            "\"The Pohjaväki know: depth is not distance. It is perspective.\"",
            "\"Surface noise obscures. Deep silence reveals.\"",
            "\"What lies below affects what walks above. This is not philosophy; it is physics.\"",
            "\"The deep does not judge. It merely observes. We try to do the same.\"",
            "\"Silence accumulates wisdom. Depth accumulates silence. We are very wise.\"",
        ],
    ),
    tzakhar: (
        greetings: [
            "\"The deep stone remembers. You are noted, surface-dweller.\"",
            "\"Copper and silence — our two exports. Welcome.\"",
            "\"The Tzäkhar know your kind by echo. What sounds do you bring?\"",
            "\"Below, we hear everything above. Your arrival was expected.\"",
            "\"The deep places do not welcome easily. Consider this a compliment.\"",
        ],
        farewells: [
            "\"May Kukri's stone hold your path.\"",
            "\"The cave mouth closes. Return when the echo calls.\"",
            "\"Below, there is no horizon. Above, there is. Walk toward it.\"",
            "\"The Tzäkhar remember faces. You will not be forgotten.\"",
            "\"Deep-paths are long. Surface-paths are short. Walk wisely.\"",
        ],
        neutral: [
            "\"The Tzäkhar hear what surface-dwellers cannot. We learn from what you miss.\"",
            "\"Copper from depth is harder. We know why.\"",
            "\"The caves teach patience. Stone does not rush, and neither do we.\"",
            "\"You see the sky. We hear the stone. We are both richer for the difference.\"",
            "\"Kukri chose the deep. We followed. We do not regret it.\"",
        ],
    ),
    merak: (
        greetings: [
            "\"The current brought you. Masa's favor on the crossing.\"",
            "\"A land-walker on the waves? The Mëräk have seen stranger things.\"",
            "\"The tide favors the bold. Welcome aboard.\"",
            "\"Sea-trade is honest trade. What brings you to the water?\"",
            "\"The Mëräk know every current by name. You are in good hands.\"",
        ],
        farewells: [
            "\"Masa's current carry you to safe harbor.\"",
            "\"The tide goes out. It always returns. As shall you.\"",
            "\"Fair winds. The Mëräk will sail these waters long after.\"",
            "\"The sea connects all shores. We will meet again.\"",
            "\"Watch the horizon. That is where the answers are.\"",
        ],
        neutral: [
            "\"The Mëräk trade by sea. Distance is merely a weather report.\"",
            "\"Every current has a name. Every name has a story.\"",
            "\"The sea demands respect and rewards patience. We practice both.\"",
            "\"Masa watches those who deal fairly. The current punishes those who don't.\"",
            "\"Land-trade is fast. Sea-trade is lasting. We choose lasting.\"",
        ],
    ),
    shear: (
        greetings: [
            "\"The sand shifts. The She'ar endure. Welcome, if you endure also.\"",
            "\"Kukri's patience in the wasteland. You have walked far.\"",
            "\"The desert teaches conservation. Take only what you need.\"",
            "\"A rare visitor. The She'ar see few who choose to come.\"",
            "\"Heat and silence. That is what we offer. Also: truth.\"",
        ],
        farewells: [
            "\"May Kukri's silence keep you cool in hot places.\"",
            "\"The sand erases all tracks. Including yours. Walk carefully.\"",
            "\"The desert does not remember those who hurry. Walk with purpose.\"",
            "\"From sand to sand, farewell.\"",
            "\"The She'ar remain. Others pass. Such is the way of dry places.\"",
        ],
        neutral: [
            "\"The She'ar know: scarcity teaches what abundance cannot.\"",
            "\"Desert wisdom: carry only what sustains. Doubt everything else.\"",
            "\"The sand hides much. We see what surface-dwellers miss.\"",
            "\"Kukri's solitude is not punishment. It is purification.\"",
            "\"A fire that burns too hot consumes itself. We burn low and long.\"",
        ],
    ),
    hal: (
        greetings: [
            "\"From the canopy, welcome. The Häl see far from above.\"",
            "\"Keuru's green mantle covers all. You stand beneath it now.\"",
            "\"The forest-path brought you here. Keuru approves.\"",
            "\"A ground-walker, but welcome among the branches.\"",
            "\"The canopy provides. The Häl are proof of this.\"",
        ],
        farewells: [
            "\"May Keuru's canopy shelter your path.\"",
            "\"The branches bend but do not break. Walk as they do.\"",
            "\"The canopy remembers all who pass below. You are remembered.\"",
            "\"From canopy to forest floor, farewell.\"",
            "\"The Häl watch from above. We will see you again.\"",
        ],
        neutral: [
            "\"The Häl live where others look. This gives us perspective.\"",
            "\"From the canopy, everything looks smaller. Problems included.\"",
            "\"Keuru's forest is not just trees. It is community.\"",
            "\"What the ground cannot see, the canopy reveals.\"",
            "\"We do not live in trees. We live among them. The difference matters.\"",
        ],
    ),
    khor: (
        greetings: [
            "\"The steppe stretches far. Welcome, walker of distances.\"",
            "\"Sampsa's old wisdom in the cold wind. You have traveled far.\"",
            "\"The Khör remember everything in song. What song do you bring?\"",
            "\"The tundra teaches endurance. Welcome to its school.\"",
