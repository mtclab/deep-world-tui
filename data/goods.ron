// Trade-goods registry (#678) — the long tail of the economy, in data.
//
// Format: Vec<GoodDef> where GoodDef = (slug, name, price, tags).
//   - slug:  stable id a save stores; never reuse a slug for a different good.
//   - price: base coin value before market lean.
//   - tags:  grouping/colour/future-production hints (free-form).
//
// The ~25 core ItemType variants (Food, Tool, Iron, ...) are NOT here — they
// carry code behaviour. Everything here is bought/carried/priced/sold through
// the generic Good(GoodId) path. Grow this file freely; thousands are fine.
[
    // ── Spices & seasonings ───────────────────────────────────────────────
    (slug: "salt",        name: "Salt",          price: 4,  tags: ["preservative", "staple", "trade"]),
    (slug: "saffron",     name: "Saffron",       price: 40, tags: ["spice", "luxury"]),
    (slug: "pepper",      name: "Black Pepper",  price: 18, tags: ["spice", "trade"]),
    (slug: "cumin",       name: "Cumin",         price: 9,  tags: ["spice"]),
    (slug: "dried-thyme", name: "Dried Thyme",   price: 5,  tags: ["spice", "herb"]),
